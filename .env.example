# Suggest Bridge — environment template
# Copy to .env and fill in values. Never commit .env to git.

# --- Run mode (set tokens for the platforms you use) -------------------------
# Both platforms:  BOT_TOKEN + DISCORD_TOKEN + ADMIN_IDS + CHANNEL_ID
# Telegram only:  BOT_TOKEN + ADMIN_IDS + CHANNEL_ID (omit DISCORD_TOKEN)
# Discord only:   DISCORD_TOKEN + OWNER_DISCORD_ID (omit BOT_TOKEN)

BOT_TOKEN=REPLACE_ME
# Telegram admin user ids, comma-separated
ADMIN_IDS=REPLACE_ME
# Publication channel id, format -100xxxxxxxxxx
CHANNEL_ID=REPLACE_ME

DISCORD_TOKEN=REPLACE_ME

# Super-admin ids (optional; Telegram owner falls back to first ADMIN_IDS)
# OWNER_TELEGRAM_ID=
OWNER_DISCORD_ID=REPLACE_ME

BRIDGE_DB_PATH=./data/bridge.db

# --- Channel naming (Russian defaults; customize for your community) ----------
# SUGGEST_HASHTAG=#предложка
# ANON_NAME=Аноним
# SETUP_CATEGORY_NAME=ПРЕДЛОЖКИ
# SETUP_SUGGEST_CHANNEL_NAME=посты-предложения
# SETUP_MOD_CHANNEL_NAME=модерация-предложки
# SETUP_PUBLISH_CHANNEL_NAME=предложка
# SETUP_PUBLISH_CHANNEL_ALIASES=посты-опубликованно
# SETUP_EDITOR_ROLE_NAME=недоадмин


# --- Pass rooms (optional Discord temporary role) -----------------------------
# Members request /prohodka; mods approve on the suggest moderation card.
# /setup_pass creates or locks channels behind the role (repeatable).
# DISCORD_PASS_ROLE_ID=
# DISCORD_PASS_COMMAND=проходка
# DISCORD_PASS_LABEL=проходка
# DISCORD_PASS_ROLE_NAME=проходка
# DISCORD_PASS_CHANNEL_NAME=проходка
# DISCORD_PASS_CATEGORY_NAME=закрытые каналы
# DISCORD_PASS_DURATION_SEC=18000
# DISCORD_PASS_REJECT_COOLDOWN_SEC=300
# DISCORD_PASS_ANTISPAM_LIMIT=5
# DISCORD_PASS_ANTISPAM_WINDOW_SEC=600
# DISCORD_PASS_ANTISPAM_STRIKE_SEC=900
# DISCORD_PASS_DEBOUNCE_SEC=8
# DISCORD_PASS_EXPIRY_POLL_SEC=30


# --- Multi-PC host (optional, Windows admin PCs) ------------------------------
# HOST_ID defaults to {COMPUTERNAME}:{USERNAME}
# HOST_SYNC_DIR=%LOCALAPPDATA%\suggest-host-sync
# HOST_ROLE=primary
# HOST_LEASE_TTL_SEC=60
# HOST_HEARTBEAT_SEC=20
