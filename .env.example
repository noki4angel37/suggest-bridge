# Suggest Bridge — environment template
# Copy to .env and fill in values. Never commit .env to git.
#
# Quick prepare (Windows):
#   .\scripts\deploy\prepare-env.ps1
# Quick prepare (Linux/macOS):
#   bash scripts/deploy/prepare-env.sh

# --- Run mode (set tokens for the platforms you use) -------------------------
# Both platforms:  BOT_TOKEN + DISCORD_TOKEN + ADMIN_IDS + CHANNEL_ID
# Telegram only:  BOT_TOKEN + ADMIN_IDS + CHANNEL_ID (omit DISCORD_TOKEN)
# Discord only:   DISCORD_TOKEN + OWNER_DISCORD_ID (omit BOT_TOKEN)

BOT_TOKEN=REPLACE_ME
# Telegram admin user ids, comma-separated
ADMIN_IDS=REPLACE_ME
# Publication channel id, format -100xxxxxxxxxx
CHANNEL_ID=REPLACE_ME

DISCORD_TOKEN=REPLACE_ME

# Super-admin ids (optional; Telegram owner falls back to first ADMIN_IDS)
# OWNER_TELEGRAM_ID=
OWNER_DISCORD_ID=REPLACE_ME

# Short product updates → Discord #изменения-бота (/bot_news)
# DISCORD_BOT_NEWS_CHANNEL_ID=1542481352644104193

BRIDGE_DB_PATH=./data/bridge.db

# --- Optional third-party modules (allowlist) ---------------------------
# Comma- or newline-separated import specs: package.module:ClassName
# or absolute path: /path/to/module.py:ClassName
# Example (repo root): examples/sample_module/module.py:SampleModule
# SB_MODULES=

# Optional JSONL operator audit (default: ./data/events.jsonl next to the package)
# SUGGEST_EVENT_LOG=./data/events.jsonl

# --- Health (Docker / systemd / VPS) -----------------------------------------
# JSON GET http://127.0.0.1:8080/healthz — status + platform checks
HEALTH_PORT=8080

# --- Channel naming (Russian defaults; customize for your community) ----------
# SUGGEST_HASHTAG=#предложка
# ANON_NAME=Аноним
# SETUP_CATEGORY_NAME=ПРЕДЛОЖКИ
# SETUP_SUGGEST_CHANNEL_NAME=посты-предложения
# SETUP_MOD_CHANNEL_NAME=модерация-предложки
# SETUP_PUBLISH_CHANNEL_NAME=предложка
# SETUP_PUBLISH_CHANNEL_ALIASES=посты-опубликованно,посты-опубликовано
# SETUP_EDITOR_ROLE_NAME=недоадмин

# --- Pass rooms (optional Discord temporary role) -----------------------------
# Members request /prohodka; mods approve on the suggest moderation card.
# /setup_pass creates or locks channels behind the role (repeatable).
# DISCORD_PASS_ROLE_ID=
# DISCORD_PASS_COMMAND=проходка
# DISCORD_PASS_LABEL=проходка
# DISCORD_PASS_ROLE_NAME=проходка
# DISCORD_PASS_CHANNEL_NAME=проходка
# DISCORD_PASS_CATEGORY_NAME=закрытые каналы
# DISCORD_PASS_DURATION_SEC=18000
# DISCORD_PASS_REJECT_COOLDOWN_SEC=300
# DISCORD_PASS_ANTISPAM_LIMIT=5
# DISCORD_PASS_ANTISPAM_WINDOW_SEC=600
# DISCORD_PASS_ANTISPAM_STRIKE_SEC=900
# DISCORD_PASS_DEBOUNCE_SEC=8
# DISCORD_PASS_EXPIRY_POLL_SEC=30

# --- Moderation UX (optional) ------------------------------------------------
# Telegram group/supergroup id for moderation cards (instead of admin DMs)
# ADMIN_CHAT_ID=-100xxxxxxxxxx
# Comma-separated substrings; submission text containing any is rejected
# KEYWORD_BLOCKLIST=спам,реклама
# Discord channel for approve/reject audit lines
# DISCORD_MOD_LOG_CHANNEL_ID=
# Create a discussion thread under each published Discord post
# DISCORD_PUBLISH_THREADS=0

# --- Multi-PC host (optional, Windows admin PCs) ------------------------------
# REQUIRED if you use install-agent.ps1 / Syncthing host-sync.
# Same secret on every admin PC. Generate: openssl rand -hex 32
# Or run scripts/deploy/prepare-env.ps1
HOST_SYNC_SECRET=REPLACE_ME
# HOST_ID defaults to {hostname}:{USERNAME|USER|LOGNAME}
# HOST_SYNC_DIR=%LOCALAPPDATA%\suggest-host-sync
# HOST_ROLE=primary
# HOST_LEASE_TTL_SEC=60
# HOST_HEARTBEAT_SEC=20
# AGENT_TELEGRAM_ID=
# AGENT_DISCORD_ID=
# HOST_AGENT_POLL_SEC=1.5
# HOST_STANDBY_WAIT_SEC=120
# HOST_HANDOVER_TTL_SEC=90
# HOST_REQUEST_COOLDOWN_SEC=45
# HOST_AGENT_ONLINE_SEC=180
